<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Word & Picture Memory Game</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Comic Sans MS', 'Chalkboard SE', 'Fredoka', cursive, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }

        header {
            text-align: center;
            margin-bottom: 20px;
        }

        h1 {
            color: #ff4757;
            font-size: 2.5rem;
            text-shadow: 2px 2px #ffffff;
            margin-bottom: 10px;
        }

        .controls {
            display: flex;
            gap: 15px;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 20px;
            background: rgba(255, 255, 255, 0.8);
            padding: 15px 25px;
            border-radius: 50px;
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        }

        .btn {
            background-color: #ff6b81;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 20px;
            cursor: pointer;
            transition: transform 0.2s, background-color 0.2s;
        }

        .btn:hover {
            background-color: #ff4757;
            transform: scale(1.05);
        }

        .btn.active {
            background-color: #2ed573;
        }

        .stats {
            font-size: 1.2rem;
            font-weight: bold;
            color: #2f3542;
            display: flex;
            gap: 20px;
        }

        /* Game Board */
        .game-board {
            display: grid;
            gap: 15px;
            max-width: 800px;
            width: 100%;
            perspective: 1000px;
        }

        .game-board.easy {
            grid-template-columns: repeat(4, 1fr);
        }

        .game-board.medium {
            grid-template-columns: repeat(4, 1fr);
        }

        .game-board.hard {
            grid-template-columns: repeat(6, 1fr);
        }

        /* Card Styles */
        .card {
            aspect-ratio: 1;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.5s;
            cursor: pointer;
        }

        .card.flipped, .card.matched {
            transform: rotateY(180deg);
        }

        .card.matched {
            cursor: default;
        }

        .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
            user-select: none;
        }

        .card-back {
            background: linear-gradient(135deg, #70a1ff, #1e90ff);
            color: white;
            font-size: 2rem;
            border: 4px solid white;
        }

        .card-front {
            background-color: white;
            transform: rotateY(180deg);
            border: 4px solid #70a1ff;
            flex-direction: column;
            padding: 10px;
        }

        .card.matched .card-front {
            border-color: #2ed573;
            background-color: #eccc68;
        }

        .card-front img {
            max-width: 80%;
            max-height: 80%;
            object-fit: contain;
        }

        .card-front .word {
            font-size: 1.3rem;
            font-weight: bold;
            color: #2f3542;
            text-transform: uppercase;
        }

        /* Modal / Win Screen */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background: white;
            padding: 30px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            animation: popIn 0.3s ease;
        }

        @keyframes popIn {
            0% { transform: scale(0.7); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .modal h2 {
            color: #2ed573;
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .modal p {
            font-size: 1.2rem;
            margin-bottom: 20px;
            color: #57606f;
        }

        /* Mobile Responsiveness */
        @media (max-width: 600px) {
            .game-board.hard {
                grid-template-columns: repeat(4, 1fr);
            }
            .card-front .word {
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>

    <header>
        <h1>🎈 Word & Picture Match! 🎈</h1>
        <div class="controls">
            <button class="btn active" onclick="setDifficulty('easy')">Easy (3 Pairs)</button>
            <button class="btn" onclick="setDifficulty('medium')">Medium (6 Pairs)</button>
            <button class="btn" onclick="setDifficulty('hard')">Hard (12 Pairs)</button>
            <button class="btn" style="background-color: #ffa502;" onclick="resetGame()">Restart</button>
        </div>
        <div class="stats">
            <div>⏱️ Time: <span id="timer">0</span>s</div>
            <div>⭐ Matches: <span id="matches">0</span>/<span id="total-pairs">3</span></div>
        </div>
    </header>

    <div class="game-board easy" id="board"></div>

    <div class="modal" id="winModal">
        <div class="modal-content">
            <h2>🎉 Fantastic Job! 🎉</h2>
            <p>You matched all pairs in <span id="finalTime">0</span> seconds!</p>
            <button class="btn" onclick="resetGame()">Play Again</button>
        </div>
    </div>

    <script>
        // Child-friendly pair database using Twemoji SVGs for reliable images
        const cardData = [
            { id: 'cat', word: 'Cat', img: 'https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/1f431.svg' },
            { id: 'dog', word: 'Dog', img: 'https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/1f436.svg' },
            { id: 'sun', word: 'Sun', img: 'https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/2600.svg' },
            { id: 'apple', word: 'Apple', img: 'https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/1f34e.svg' },
            { id: 'car', word: 'Car', img: 'https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/1f697.svg' },
            { id: 'frog', word: 'Frog', img: 'https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/1f438.svg' },
            { id: 'star', word: 'Star', img: 'https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/2b50.svg' },
            { id: 'duck', word: 'Duck', img: 'https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/1f986.svg' },
            { id: 'pizza', word: 'Pizza', img: 'https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/1f355.svg' },
            { id: 'flower', word: 'Flower', img: 'https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/1f33c.svg' },
            { id: 'bear', word: 'Bear', img: 'https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/1f43b.svg' },
            { id: 'fish', word: 'Fish', img: 'https://cdnjs.cloudflare.com/ajax/libs/twemoji/14.0.2/svg/1f41f.svg' }
        ];

        let currentDifficulty = 'easy';
        let cards = [];
        let flippedCards = [];
        let matchedCount = 0;
        let totalPairs = 3;
        let timer = 0;
        let timerInterval = null;
        let gameStarted = false;

        const board = document.getElementById('board');
        const timerDisplay = document.getElementById('timer');
        const matchesDisplay = document.getElementById('matches');
        const totalPairsDisplay = document.getElementById('total-pairs');
        const winModal = document.getElementById('winModal');

        const difficultySettings = {
            easy: 3,
            medium: 6,
            hard: 12
        };

        function setDifficulty(level) {
            currentDifficulty = level;
            
            // Update button styles
            document.querySelectorAll('.controls .btn').forEach(btn => {
                btn.classList.remove('active');
                if (btn.textContent.toLowerCase().includes(level)) {
                    btn.classList.add('active');
                }
            });

            resetGame();
        }

        function startTimer() {
            if (!gameStarted) {
                gameStarted = true;
                timerInterval = setInterval(() => {
                    timer++;
                    timerDisplay.textContent = timer;
                }, 1000);
            }
        }

        function stopTimer() {
            clearInterval(timerInterval);
            gameStarted = false;
        }

        function resetGame() {
            stopTimer();
            timer = 0;
            matchedCount = 0;
            flippedCards = [];
            timerDisplay.textContent = timer;
            matchesDisplay.textContent = matchedCount;
            winModal.style.display = 'none';

            totalPairs = difficultySettings[currentDifficulty];
            totalPairsDisplay.textContent = totalPairs;

            board.className = `game-board ${currentDifficulty}`;
            createBoard();
        }

        function createBoard() {
            board.innerHTML = '';
            
            // Pick subset of items based on difficulty
            const selectedData = cardData.slice(0, totalPairs);
            
            // Create separate card instances for image and text
            const deck = [];
            selectedData.forEach(item => {
                deck.push({ id: item.id, type: 'image', content: item.img });
                deck.push({ id: item.id, type: 'word', content: item.word });
            });

            // Shuffle cards
            deck.sort(() => Math.random() - 0.5);

            // Render cards to grid
            deck.forEach((data) => {
                const card = document.createElement('div');
                card.classList.add('card');
                card.dataset.id = data.id;

                const frontContent = data.type === 'image' 
                    ? `<img src="${data.content}" alt="card image">`
                    : `<span class="word">${data.content}</span>`;

                card.innerHTML = `
                    <div class="card-face card-back">❓</div>
                    <div class="card-face card-front">
                        ${frontContent}
                    </div>
                `;

                card.addEventListener('click', () => flipCard(card));
                board.appendChild(card);
            });
        }

        function flipCard(card) {
            // Start timer on first flip
            startTimer();

            // Ignore if already flipped, matched, or if 2 cards are currently flipped
            if (
                card.classList.contains('flipped') || 
                card.classList.contains('matched') || 
                flippedCards.length === 2
            ) {
                return;
            }

            card.classList.add('flipped');
            flippedCards.push(card);

            if (flippedCards.length === 2) {
                checkMatch();
            }
        }

        function checkMatch() {
            const [card1, card2] = flippedCards;
            const isMatch = card1.dataset.id === card2.dataset.id;

            if (isMatch) {
                card1.classList.add('matched');
                card2.classList.add('matched');
                matchedCount++;
                matchesDisplay.textContent = matchedCount;
                flippedCards = [];

                if (matchedCount === totalPairs) {
                    stopTimer();
                    setTimeout(showWinScreen, 500);
                }
            } else {
                setTimeout(() => {
                    card1.classList.remove('flipped');
                    card2.classList.remove('flipped');
                    flippedCards = [];
                }, 1000);
            }
        }

        function showWinScreen() {
            document.getElementById('finalTime').textContent = timer;
            winModal.style.display = 'flex';
        }

        // Initialize Game
        resetGame();
    </script>
</body>
</html>
